# Conexión a Postgres (Supabase → Project Settings → Database → Connection string, "Session pooler")
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Fotos (productos y comprobantes) en Supabase Storage. Si se omiten, se guardan en server/uploads
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key>
SUPABASE_BUCKET=gioka

# Clave pública (anon / publishable) del proyecto: la reciben los navegadores para escuchar eventos en vivo (Supabase Realtime).
# Las tablas tienen RLS sin políticas, así que con esta clave no se puede leer ni escribir nada.
SUPABASE_ANON_KEY=<anon key>

# Token personal de Supabase (solo para scripts/supabase-admin.mjs)
SUPABASE_ACCESS_TOKEN=

# Zona horaria para agrupar reportes por día (por defecto la del sistema)
# TZ=America/Bogota
PORT=3001
